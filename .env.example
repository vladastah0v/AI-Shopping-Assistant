# Локальные параметры Docker Compose. Задайте два разных пароля.
POSTGRES_PASSWORD=replace-local-migration-password
SHOPPING_POSTGRES_PASSWORD=replace-local-api-password
API_PORT=8000
SHOPPING_DEPENDENCY_TIMEOUT_SECONDS=2

# Ollama на хосте. Включается при наличии загруженной модели.
SHOPPING_OLLAMA_ENABLED=false
SHOPPING_OLLAMA_MODEL=qwen2.5:1.5b
SHOPPING_OLLAMA_URL=http://host.docker.internal:11434
